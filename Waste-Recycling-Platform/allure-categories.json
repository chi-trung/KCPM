[
  {
    "name": "Assertion Failure",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)assert|expected|should be|fluentassertions|xunit.sdk.xunitexception|AssertionError"
  },
  {
    "name": "Authorization / Token Failure",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)unauthorized|forbidden|authorization|access denied|invalid token|401|403|jwt|bearer"
  },
  {
    "name": "Validation / Bad Request",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)validation|invalid|required|bad request|cannot be null|400|ArgumentException|format"
  },
  {
    "name": "State Transition Error",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)InvalidOperationException|state|transition|pending|accepted|rejected|collected|assigned|OnTheWay"
  },
  {
    "name": "Not Found",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)not found|KeyNotFoundException|404|does not exist|no such"
  },
  {
    "name": "Database / Infrastructure",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)sql|entityframework|database|dbcontext|inmemory|efcore|connection|socket|ioexception"
  },
  {
    "name": "Timeout / Flaky",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": "(?i)timeout|timed out|deadline|deadlock|TaskCanceledException|flaky"
  },
  {
    "name": "File / Storage Error",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)file|upload|storage|extension|oversized|stream|byte|SaveFile"
  },
  {
    "name": "Postman / API Error",
    "matchedStatuses": ["failed"],
    "messageRegex": "(?i)postman|newman|pm.test|AssertionError|5[0-9]{2}|response code"
  },
  {
    "name": "Test Infrastructure Error",
    "matchedStatuses": ["broken"],
    "messageRegex": "(?i)NullReferenceException|setup|teardown|fixture|cannot instantiate"
  }
]