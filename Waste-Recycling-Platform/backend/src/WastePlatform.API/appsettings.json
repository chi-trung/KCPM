{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3307;Database=WastePlatformDB;User=wasteuser;Password=${DB_PASSWORD};CharSet=utf8mb4;"
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "kcpm-dev-only-jwt-secret-key-2026-override-with-env-var-in-production",
    "Issuer": "waste-platform",
    "Audience": "waste-platform-users",
    "ExpirationMinutes": 60
  }
}
