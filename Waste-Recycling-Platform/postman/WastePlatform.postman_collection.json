{
  "info": {
    "_postman_id": "6f7b8cc3-6905-4fd1-a7af-4df7c1aef2be",
    "name": "WastePlatform API - Jira/GitHub/Postman Linked Suite",
    "description": "Collection linked to Jira tickets and GitHub commits.\n\nNaming convention: [JIRA-KEY] Feature / API action.\nUse the same Jira key in branch, commit, PR, and collection run notes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "jiraKey",
      "value": "WASTE-TEST-001"
    }
  ],
  "item": [
    {
      "name": "[{{jiraKey}}] Health Check",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "GitHub commit evidence: this request should stay green on every push. Jira key: {{jiraKey}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('body status is ok', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "[{{jiraKey}}] Auth Surface",
      "item": [
        {
          "name": "GET Roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "roles"]
            },
            "description": "Matches the auth area tracked in GitHub commits and Jira tickets."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('roles array exists', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.roles).to.be.an('array');",
                  "  pm.expect(body.roles.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Use this request for manual smoke validation; set real credentials before running against a live environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('response is either success or auth failure', function () {",
                  "  pm.expect([200, 401, 400, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}